{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Lume",
  "version": "0.1.0",
  "identifier": "com.lume.desktop",
  "build": {
    "devUrl": "http://127.0.0.1:3000",
    "frontendDist": "../../web/dist"
  },
  "app": {
    "windows": [
      {
        "title": "Lume",
        "width": 1640,
        "height": 960,
        "theme": "Light",
        "titleBarStyle": "Overlay"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "icon": [
      "icons/icon.icns",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "externalBin": [],
    "resources": [
      "resources/default-skills.tar",
      "binaries/lume-natives.node",
      "binaries/lume-sidecar.js",
      "binaries/sidecar-node-modules.zip",
      "binaries/sidecar-node-bridge.mjs"
    ],
    "targets": "all",
    "category": "DeveloperTool",
    "shortDescription": "Local-first AI Agent desktop app",
    "longDescription": "Lume is a local-first AI Agent desktop app.",
    "macOS": {
      "minimumSystemVersion": "11.0"
    },
    "windows": {
      "nsis": {
        "installMode": "perMachine",
        "displayLanguageSelector": false
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "__LUME_UPDATER_PUBLIC_KEY__",
      "endpoints": [
        "https://github.com/CavinHuang/lume/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
