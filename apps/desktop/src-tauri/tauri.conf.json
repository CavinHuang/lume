{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Lume",
  "version": "0.1.0",
  "identifier": "com.lume.desktop",
  "build": {
    "devUrl": "http://127.0.0.1:3000",
    "frontendDist": "../../web/dist"
  },
  "app": {
    "windows": [
      {
        "title": "Lume",
        "width": 1440,
        "height": 900
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["dmg", "nsis", "msi", "deb", "appimage"],
    "externalBin": ["binaries/lume-sidecar"],
    "createUpdaterArtifacts": true,
    "resources": {
      "../../sidecar/default-skills": "default-skills"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "REPLACE_WITH_TAURI_UPDATER_PUBLIC_KEY",
      "endpoints": [
        "https://github.com/CavinHuang/lume/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
