{
  "name": "@lume/desktop",
  "version": "0.3.0",
  "private": true,
  "description": "Lume desktop shell powered by Electron",
  "author": "Lume Team",
  "repository": {
    "type": "git",
    "url": "https://github.com/CavinHuang/lume.git"
  },
  "type": "module",
  "main": "dist/main/main.mjs",
  "scripts": {
    "dev": "bun ./scripts/dev.ts",
    "build:runtime": "bun ./scripts/build.ts",
    "build:natives": "bun ../../scripts/build-natives-binary.mjs",
    "build": "bun ./scripts/build-agent-island-native.ts && bun ./scripts/build.ts && bun ../../scripts/build-natives-binary.mjs && node ../../scripts/build-ripgrep-resources.mjs && node ../../scripts/build-officecli-resources.mjs && bun ../../scripts/build-sidecar-bundle.mjs && bun ../../scripts/build-default-skills-archive.mjs && node ../../scripts/build-node-repl-resources.mjs && node ../../scripts/build-desktop-host-resources.mjs && node ./scripts/run-electron-builder.mjs --output-dir dist-unpacked --dir --publish never --config.directories.output=dist-unpacked",
    "package": "bun ./scripts/build-agent-island-native.ts && bun ./scripts/build.ts && bun ../../scripts/build-natives-binary.mjs && node ../../scripts/build-ripgrep-resources.mjs && node ../../scripts/build-officecli-resources.mjs && bun ../../scripts/build-sidecar-bundle.mjs && bun ../../scripts/build-default-skills-archive.mjs && node ../../scripts/build-node-repl-resources.mjs && node ../../scripts/build-desktop-host-resources.mjs && node ./scripts/run-electron-builder.mjs --output-dir dist-release --publish never --config.directories.output=dist-release",
    "typecheck": "tsc -p tsconfig.json --noEmit && node --check ./scripts/electron-runtime.mjs",
    "test": "bun test ./src/browser-cdp-input.test.ts ./scripts/desktop-package.test.mjs ./scripts/sidecar-process.test.mjs ./scripts/desktop-core.test.mjs ./scripts/plugin-native-host-installer.test.mjs ./scripts/tray-window-runtime.test.mjs ./scripts/tray-manager.test.mjs ./scripts/logging-service.test.mjs ./scripts/log-digest-policy.test.mjs ./scripts/diagnostic-content-store.test.mjs ./scripts/settings-broker.test.mjs ./scripts/electron-runtime.test.mjs ./scripts/electron-security.test.mjs ./scripts/browser-audit.test.mjs ./scripts/browser-credentials.test.mjs ./scripts/browser-cursor.test.mjs ./scripts/browser-downloads.test.mjs ./scripts/browser-import.test.mjs ./scripts/browser-network-guard.test.mjs ./scripts/browser-reference-grants.test.mjs ./scripts/browser-runtime-policy.test.mjs ./scripts/browser-sharing-policy.test.mjs ./scripts/desktop-signature.test.mjs ./src/desktop-host-supervisor.test.ts ./src/office-preview.test.ts ./src/browser-workspace-store.test.ts ./src/agent-island-service.test.ts ./src/browser-annotation-session.test.ts ./src/browser-annotation-manager.test.ts ./src/voice-asr-service.test.ts ./src/voice-dictation-settings-service.test.ts ./src/desktop-core.voice-mic.test.ts && node --experimental-vm-modules --test ./scripts/node-repl-worker.test.mjs",
    "test:node-repl-worker": "node --experimental-vm-modules --test ./scripts/node-repl-worker.test.mjs",
    "test:unit": "bun run test",
    "test:smoke": "bun test ./scripts/desktop-context-key.test.mjs ./scripts/desktop-package.test.mjs && node --experimental-vm-modules --test ./scripts/node-repl-worker.test.mjs && bun test ./scripts/sidecar-process.test.mjs ./scripts/desktop-core.test.mjs ./src/desktop-host-supervisor.test.ts ./src/browser-workspace-store.test.ts ./src/agent-island-service.test.ts ./src/browser-annotation-session.test.ts ./src/browser-annotation-manager.test.ts ./src/voice-asr-service.test.ts ./src/voice-dictation-settings-service.test.ts ./src/desktop-core.voice-mic.test.ts",
    "test:browser-e2e": "bun ./scripts/browser-runtime.e2e.mjs",
    "test:browser-extension-smoke": "bun ./scripts/browser-extension-smoke.mjs",
    "test:browser-import-live-smoke": "node ./scripts/browser-import-live-smoke.mjs",
    "test:packaged-browser-extension-smoke": "bun ./scripts/browser-extension-smoke.mjs --packaged-lume",
    "test:packaged-smoke": "node ./scripts/packaged-desktop-smoke.mjs"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "42.5.1",
    "electron-builder": "24.13.3",
    "electron-updater": "6.8.9",
    "happy-dom": "^15.11.7",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "typescript": "^5.9.3",
    "vite": "^6.3.0"
  },
  "build": {
    "appId": "com.lume.desktop",
    "productName": "Lume",
    "asar": true,
    "directories": {
      "buildResources": "assets",
      "output": "dist-package"
    },
    "artifactName": "${productName}-${version}-${arch}.${ext}",
    "afterPack": "scripts/after-pack.cjs",
    "files": [
      "dist/main/main.mjs",
      "dist/preload/preload.cjs",
      "dist/preload/browser-auth-preload.cjs",
      "dist/preload/browser-guest-preload.cjs",
      "assets"
    ],
    "extraResources": [
      {
        "from": "../web/dist",
        "to": "web"
      },
      {
        "from": "../web/src/assets/imgs/logo.png",
        "to": "tray-icon.png"
      },
      {
        "from": "../../templates/workspace",
        "to": "templates/workspace"
      },
      {
        "from": "resources/default-skills.tar",
        "to": "default-skills.tar"
      },
      {
        "from": "../sidecar/bundled-plugins",
        "to": "bundled-plugins"
      },
      {
        "from": "resources/sidecar",
        "to": "sidecar"
      },
      {
        "from": "resources/data",
        "to": "data"
      },
      {
        "from": "resources/package.json",
        "to": "package.json"
      },
      {
        "from": "resources/natives",
        "to": "natives"
      },
      {
        "from": "resources/ripgrep",
        "to": "ripgrep"
      },
      {
        "from": "resources/officecli",
        "to": "officecli"
      },
      {
        "from": "resources/bin",
        "to": "bin"
      },
      {
        "from": "resources/node-repl",
        "to": "node-repl"
      },
      {
        "from": "resources/desktop-host",
        "to": "desktop-host"
      }
    ],
    "mac": {
      "icon": "assets/icon.icns",
      "category": "public.app-category.productivity",
      "hardenedRuntime": true,
      "entitlements": "assets/entitlements.mac.plist",
      "entitlementsInherit": "assets/entitlements.mac.plist",
      "notarize": false,
      "extraResources": [
        {
          "from": "resources/agent-island",
          "to": "agent-island",
          "filter": [
            "**/*"
          ]
        }
      ],
      "extendInfo": {
        "NSMicrophoneUsageDescription": "语音输入功能需要使用麦克风将您说的话转写为文字。音频仅在您主动使用听写时采集。"
      }
    },
    "dmg": {
      "contents": [
        {
          "x": 130,
          "y": 220
        },
        {
          "x": 410,
          "y": 220,
          "type": "link",
          "path": "/Applications"
        },
        {
          "x": 270,
          "y": 340,
          "type": "file",
          "path": "assets/mac-install-guide.txt"
        }
      ]
    },
    "win": {
      "icon": "assets/icon.ico",
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "linux": {
      "icon": "assets/icon.png",
      "target": [
        "AppImage"
      ]
    },
    "publish": [
      {
        "provider": "github"
      }
    ]
  },
  "dependencies": {
    "@lume/shared": "workspace:*",
    "@types/ws": "^8.18.1",
    "ws": "^8.21.3"
  }
}