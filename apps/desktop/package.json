{
  "name": "@lume/desktop",
  "version": "0.1.8",
  "private": true,
  "description": "Lume desktop shell powered by Electron",
  "author": "Lume Team",
  "repository": {
    "type": "git",
    "url": "https://github.com/CavinHuang/lume.git"
  },
  "type": "module",
  "main": "dist/main/main.mjs",
  "scripts": {
    "dev": "bun ./scripts/dev.ts",
    "build:runtime": "bun ./scripts/build.ts",
    "build:natives": "bun ../../scripts/build-natives-binary.mjs",
    "build": "bun ./scripts/build.ts && bun ../../scripts/build-natives-binary.mjs && bun ../../scripts/build-sidecar-bundle.mjs && bun ../../scripts/build-default-skills-archive.mjs && node ../../scripts/build-node-repl-resources.mjs && node ../../scripts/build-desktop-host-resources.mjs && node ./scripts/run-electron-builder.mjs --output-dir dist-unpacked --dir --publish never --config.directories.output=dist-unpacked",
    "package": "bun ./scripts/build.ts && bun ../../scripts/build-natives-binary.mjs && bun ../../scripts/build-sidecar-bundle.mjs && bun ../../scripts/build-default-skills-archive.mjs && node ../../scripts/build-node-repl-resources.mjs && node ../../scripts/build-desktop-host-resources.mjs && node ./scripts/run-electron-builder.mjs --output-dir dist-release --publish never --config.directories.output=dist-release",
    "typecheck": "tsc -p tsconfig.json --noEmit && node --check ./scripts/electron-runtime.mjs",
    "test": "bun test ./scripts/desktop-package.test.mjs ./scripts/sidecar-process.test.mjs ./scripts/desktop-core.test.mjs ./scripts/tray-window-runtime.test.mjs ./scripts/tray-manager.test.mjs ./scripts/logging-service.test.mjs ./scripts/log-digest-policy.test.mjs ./scripts/diagnostic-content-store.test.mjs ./scripts/settings-broker.test.mjs ./scripts/electron-runtime.test.mjs ./scripts/electron-security.test.mjs"
  },
  "devDependencies": {
    "electron": "42.5.1",
    "electron-builder": "24.13.3",
    "electron-updater": "6.8.9",
    "typescript": "^5.9.3",
    "vite": "^6.3.0"
  },
  "build": {
    "appId": "com.lume.desktop",
    "productName": "Lume",
    "asar": true,
    "directories": {
      "buildResources": "assets",
      "output": "dist-package"
    },
    "artifactName": "${productName}-${version}-${arch}.${ext}",
    "afterPack": "scripts/after-pack.cjs",
    "files": [
      "dist/main/main.mjs",
      "dist/preload/preload.cjs",
      "assets"
    ],
    "extraResources": [
      {
        "from": "../web/dist",
        "to": "web"
      },
      {
        "from": "../web/src/assets/imgs/logo.png",
        "to": "tray-icon.png"
      },
      {
        "from": "resources/default-skills.tar",
        "to": "default-skills.tar"
      },
      {
        "from": "../sidecar/bundled-plugins",
        "to": "bundled-plugins"
      },
      {
        "from": "resources/sidecar",
        "to": "sidecar"
      },
      {
        "from": "resources/data",
        "to": "data"
      },
      {
        "from": "resources/package.json",
        "to": "package.json"
      },
      {
        "from": "resources/natives",
        "to": "natives"
      },
      {
        "from": "resources/node-repl",
        "to": "node-repl"
      },
      {
        "from": "resources/desktop-host",
        "to": "desktop-host"
      }
    ],
    "mac": {
      "icon": "assets/icon.icns",
      "category": "public.app-category.productivity",
      "hardenedRuntime": true,
      "identity": null,
      "entitlements": "assets/entitlements.mac.plist",
      "entitlementsInherit": "assets/entitlements.mac.plist",
      "notarize": false
    },
    "dmg": {
      "contents": [
        {
          "x": 130,
          "y": 220
        },
        {
          "x": 410,
          "y": 220,
          "type": "link",
          "path": "/Applications"
        },
        {
          "x": 270,
          "y": 340,
          "type": "file",
          "path": "assets/mac-install-guide.txt"
        }
      ]
    },
    "win": {
      "icon": "assets/icon.ico",
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "linux": {
      "icon": "assets/icon.png",
      "target": [
        "AppImage"
      ]
    },
    "publish": [
      {
        "provider": "github"
      }
    ]
  },
  "dependencies": {}
}
