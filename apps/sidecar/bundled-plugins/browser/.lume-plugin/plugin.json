{
  "schema": "lume-plugin/v1",
  "name": "browser",
  "version": "1.0.0",
  "description": "Control task-isolated pages in the Lume in-app browser.",
  "displayName": "Lume Browser",
  "category": "Browser",
  "skills": ["./skills"],
  "permissions": {
    "filesystem": { "read": ["./**"], "write": [] },
    "network": { "outbound": [] },
    "mcpServers": { "register": false },
    "shell": { "allow": false },
    "tools": { "allow": ["mcp__node_repl__js"], "deny": ["Bash"] }
  }
}
