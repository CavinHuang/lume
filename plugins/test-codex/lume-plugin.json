{
  "schema": "lume-plugin/v1",
  "name": "test-codex",
  "version": "1.0.0",
  "description": "Test Codex plugin for Lume plugin system",
  "author": "Test",
  "displayName": "Test Codex",
  "category": "Productivity",
  "skills": [
    "./skills/"
  ],
  "hooks": "./hooks/hooks.json",
  "mcpServers": "./mcp.json",
  "permissions": {
    "filesystem": {
      "read": [
        "./**"
      ],
      "write": [
        "./data/**"
      ]
    },
    "network": {
      "outbound": []
    },
    "mcpServers": {
      "register": true
    },
    "shell": {
      "allow": true
    },
    "tools": {
      "allow": [
        "FileRead",
        "Glob",
        "Grep",
        "WebFetch",
        "WebSearch",
        "TaskList",
        "TaskGet",
        "AskUserQuestion",
        "Config"
      ],
      "deny": [
        "Bash",
        "FileWrite",
        "FileEdit",
        "NotebookEdit",
        "EnterWorktree",
        "ExitWorktree",
        "AgentTool",
        "SendMessage"
      ]
    },
    "hooks": {
      "events": [
        "PreToolUse",
        "PostToolUse",
        "PermissionRequest",
        "PreCompact",
        "PostCompact",
        "SessionStart",
        "UserPromptSubmit",
        "SubagentStart",
        "SubagentStop",
        "Stop"
      ]
    }
  },
  "lume": {
    "hooksOnly": false
  }
}