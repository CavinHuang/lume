{
  "name": "@lume/cli",
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "bun": ">=1.3.0"
  },
  "bin": {
    "lume": "./dist/bin.js"
  },
  "main": "./dist/cli.js",
  "types": "./dist/cli.d.ts",
  "exports": {
    ".": {
      "types": "./dist/cli.d.ts",
      "import": "./dist/cli.js"
    },
    "./errors": {
      "types": "./dist/errors.d.ts",
      "import": "./dist/errors.js"
    },
    "./output": {
      "types": "./dist/output.d.ts",
      "import": "./dist/output.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "dependencies": {
    "@lume/shared": "workspace:*",
    "@lume/sidecar": "workspace:*",
    "cac": "^6.7.14",
    "zod": "^3.23.8"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "bun test src/cli.test.ts"
  }
}
