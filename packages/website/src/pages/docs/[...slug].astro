---
import { getCollection, type CollectionEntry } from 'astro:content';
import DocsPage from '../../components/pages/DocsPage.astro';

export async function getStaticPaths() {
  const docs = await getCollection('docs', (entry) => entry.id.startsWith('zh/'));
  const paths: {
    params: { slug: string | undefined };
    props: { entry: CollectionEntry<'docs'> | undefined };
  }[] = docs.map((entry) => ({
    params: { slug: entry.id.slice(3) },
    props: { entry },
  }));
  // /docs 无 slug → 目录页
  paths.push({ params: { slug: undefined }, props: { entry: undefined } });
  return paths;
}

const { entry } = Astro.props as { entry?: CollectionEntry<'docs'> };
---

<DocsPage lang="zh" entry={entry} />
