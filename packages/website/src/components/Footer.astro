---
import { REPO_URL, withBase } from '../lib/site';
import { t, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;

const langPrefix = lang === 'zh' ? '' : '/en';
const product = [
  { href: withBase(`${langPrefix}/download`), label: t(lang, 'nav.download') },
  { href: withBase(`${langPrefix}/docs`), label: t(lang, 'nav.docs') },
  { href: withBase(`${langPrefix}/changelog`), label: t(lang, 'nav.changelog') },
];
---

<footer class="bg-bg">
  <div class="mx-auto grid max-w-7xl gap-10 px-4 py-14 sm:px-6 md:grid-cols-[1fr_auto_auto] lg:px-8">
    <div>
      <div class="flex items-center gap-2 font-semibold">
        <img src={withBase('/logo.png')} alt="Lume" class="h-7 w-7 rounded-lg" />
        <span class="text-title tracking-tight">Lume</span>
      </div>
      <p class="mt-4 max-w-sm text-ui leading-relaxed text-fg-muted">
        {t(lang, 'footer.tagline')}
      </p>
      <div class="mt-5 flex flex-wrap gap-2 text-micro font-medium text-fg-muted">
        <span class="rounded-full border border-border px-3 py-1">Local first</span>
        <span class="rounded-full border border-border px-3 py-1">Open source</span>
        <span class="rounded-full border border-border px-3 py-1">MIT</span>
      </div>
    </div>
    <div>
      <h3 class="text-ui font-semibold text-fg">{t(lang, 'footer.product')}</h3>
      <ul class="mt-3 space-y-2 text-ui">
        {product.map((link) => (
          <li><a href={link.href} class="text-fg-muted transition-colors hover:text-accent">{link.label}</a></li>
        ))}
      </ul>
    </div>
    <div>
      <h3 class="text-ui font-semibold text-fg">{t(lang, 'footer.community')}</h3>
      <ul class="mt-3 space-y-2 text-ui">
        <li>
          <a
            href={REPO_URL}
            target="_blank"
            rel="noopener noreferrer"
            class="text-fg-muted transition-colors hover:text-accent">GitHub</a
          >
        </li>
        <li>
          <a
            href={`${REPO_URL}/issues`}
            target="_blank"
            rel="noopener noreferrer"
            class="text-fg-muted transition-colors hover:text-accent">Issues</a
          >
        </li>
        <li>
          <a
            href={`${REPO_URL}/blob/main/LICENSE`}
            target="_blank"
            rel="noopener noreferrer"
            class="text-fg-muted transition-colors hover:text-accent">{t(lang, 'footer.license')}</a
          >
        </li>
      </ul>
    </div>
  </div>
  <div class="border-t border-border py-5">
    <div class="mx-auto flex max-w-7xl flex-col gap-2 px-4 text-micro text-fg-faint sm:flex-row sm:items-center sm:justify-between sm:px-6 lg:px-8">
      <p>{t(lang, 'footer.copyright')}</p>
      <p>Windows · macOS · GitHub</p>
    </div>
  </div>
</footer>
