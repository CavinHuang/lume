---
import { getLangFromUrl, t } from '../i18n/ui';
const lang = getLangFromUrl(Astro.url);
---

<button
  type="button"
  data-theme-toggle
  data-label-to-light={t(lang, 'theme.toLight')}
  data-label-to-dark={t(lang, 'theme.toDark')}
  aria-label={t(lang, 'theme.toDark')}
  title={t(lang, 'theme.toDark')}
  class="rounded-lg p-1.5 text-fg-muted transition-colors hover:bg-surface-hover hover:text-fg"
>
  <!-- 太阳：暗色模式下显示（点击切回亮色） -->
  <svg
    class="hidden h-5 w-5 dark:block"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="2"
    stroke-linecap="round"
    aria-hidden="true"
  >
    <circle cx="12" cy="12" r="4"></circle>
    <path
      d="M12 2v2m0 16v2M4.9 4.9l1.4 1.4m11.4 11.4 1.4 1.4M2 12h2m16 0h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"
    ></path>
  </svg>
  <!-- 月亮：亮色模式下显示 -->
  <svg
    class="block h-5 w-5 dark:hidden"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="2"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
  >
    <path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8Z"></path>
  </svg>
</button>

<script>
  const syncThemeUi = (theme: 'light' | 'dark') => {
    document.querySelectorAll<HTMLButtonElement>('[data-theme-toggle]').forEach((button) => {
      const label = theme === 'dark' ? button.dataset.labelToLight : button.dataset.labelToDark;
      if (label) {
        button.setAttribute('aria-label', label);
        button.title = label;
      }
      button.setAttribute('aria-pressed', String(theme === 'dark'));
    });
    document.querySelector<HTMLMetaElement>('meta[name="theme-color"]')?.setAttribute(
      'content',
      theme === 'dark' ? '#101512' : '#f8faf7',
    );
  };

  const applyTheme = (theme: 'light' | 'dark') => {
    document.documentElement.dataset.theme = theme;
    syncThemeUi(theme);
    try {
      localStorage.setItem('theme', theme);
    } catch {
      /* 隐私模式等场景下存不了就算了 */
    }
  };

  document.querySelectorAll<HTMLButtonElement>('[data-theme-toggle]').forEach((button) => {
    button.addEventListener('click', () => {
      applyTheme(document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark');
    });
  });

  syncThemeUi(document.documentElement.dataset.theme === 'dark' ? 'dark' : 'light');
</script>
