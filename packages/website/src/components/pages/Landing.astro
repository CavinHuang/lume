---
import Base from '../../layouts/Base.astro';
import { t, type Lang, type UiKey } from '../../i18n/ui';
import { REPO_URL, withBase } from '../../lib/site';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const langPrefix = lang === 'zh' ? '' : '/en';
const downloadHref = withBase(`${langPrefix}/download`);
const docsHref = withBase(`${langPrefix}/docs`);

const members = [
  { id: 'explorer', displayName: '陆寻', name: 'Lucas Lu', avatar: 'explorer.jpg' },
  { id: 'planner', displayName: '沈策', name: 'Sera Shen', avatar: 'planner.jpg' },
  { id: 'code-reviewer', displayName: '审岳', name: 'Yue Shen', avatar: 'code-reviewer.jpg' },
  { id: 'researcher', displayName: '顾砚', name: 'Milo Gu', avatar: 'researcher.jpg' },
  { id: 'translator', displayName: '许澄', name: 'Clara Xu', avatar: 'translator.jpg' },
  { id: 'writer', displayName: '江岚', name: 'Rowan Jiang', avatar: 'writer.jpg' },
  { id: 'voice', displayName: '宋澈', name: 'Momo Song', avatar: 'voice.jpg' },
  { id: 'designer', displayName: '林澄', name: 'Lin Lin', avatar: 'designer.jpg' },
  { id: 'artist', displayName: '白洛', name: 'Bai Bai', avatar: 'artist.jpg' },
  { id: 'analyst', displayName: '唐栩', name: 'Tang Xu', avatar: 'analyst.jpg' },
  { id: 'quant', displayName: '纪衡', name: 'Ji Heng', avatar: 'quant.jpg' },
  { id: 'novelist', displayName: '温序', name: 'Wen Xu', avatar: 'novelist.jpg' },
  { id: 'developer', displayName: '祁远', name: 'Qi Yuan', avatar: 'developer.jpg' },
] as const;

const copy = lang === 'zh'
  ? {
      eyebrow: '运行在你电脑上的 AI 工作团队',
      heroTitleBefore: '把一句需求变成',
      heroTitleAccent: '真正完成的工作',
      heroDesc: 'Lume 不只回答问题。它理解你的工作现场，调用本地工具，记住长期偏好，并让一支专业 Agent 团队把任务推进到可交付。',
      heroPrompt: '帮我调研这个赛道，整理成一份能直接汇报的方案。',
      heroStatus: '3 位 Agent 正在并行推进',
      heroTask1: '顾砚 · 核验信息源',
      heroTask2: '唐栩 · 梳理数据结论',
      heroTask3: '林澄 · 组织汇报结构',
      heroArtAlt: 'Lume 与专业 Agent 团队在工作室协作',
      openSource: '开源 MIT',
      agentsCount: '13 位专业角色',
      localData: '数据留在本地',
      modelChoice: '模型自由选择',
      stripLead: '不是更聪明的聊天框',
      stripTitle: '是会理解、会分工、会动手的工作台。',
      workflowEyebrow: '一次任务，完整闭环',
      workflowTitle: '从目标到交付都由 Lume 推进',
      workflowDesc: '从理解上下文到交付成果，每一步都可见、可暂停、可继续。',
      workflows: [
        { step: '01', title: '理解现场', desc: '读取当前项目、文件与历史记忆，先弄清你真正要解决的问题。', label: '上下文已对齐' },
        { step: '02', title: '拆解与分工', desc: '把复杂目标拆成清晰子任务，交给更合适的角色并行处理。', label: '计划可随时调整' },
        { step: '03', title: '调用工具执行', desc: '搜索资料、处理文件、运行命令、生成图片，不停留在建议层面。', label: '过程实时可见' },
        { step: '04', title: '交付可用成果', desc: '汇总结论与产物，留下可继续推进的线程，而不是一次性答案。', label: '结果落到本地' },
      ],
      casesEyebrow: '从想法到成品',
      casesTitle: '工作创作与研究都从这里开始',
      casesDesc: '你不需要先学会写复杂提示词。把真实需求说出来，Lume 会自己找到下一步。',
      cases: [
        { tag: '调研', title: '把零散资料变成可靠结论', desc: '跨来源搜索、事实核验、提炼分歧，最后交付带来源的结构化报告。', prompt: '比较 5 个竞品，告诉我真正的机会在哪里。', people: ['researcher', 'analyst'] },
        { tag: '开发', title: '在真实代码库里推进改动', desc: '先理解约束，再定位文件、修改代码、运行验证，保留完整上下文。', prompt: '修好这个问题，别影响现有登录流程。', people: ['explorer', 'developer', 'code-reviewer'] },
        { tag: '内容', title: '从空白页到能交付的表达', desc: '调研、写作、翻译、配图各有分工，把一个模糊想法变成完整内容。', prompt: '把访谈整理成一篇有观点的中文长文。', people: ['writer', 'translator', 'artist'] },
        { tag: '日常', title: '让重复工作按时自己发生', desc: '设置日程和自动化，通过消息渠道接收结果，离开电脑也能继续推进。', prompt: '每周一汇总项目进展，并把风险发给我。', people: ['planner', 'analyst'] },
      ],
      memoryEyebrow: '持续在场的上下文',
      memoryTitle: '它记住的不只是聊天记录',
      memoryDesc: '项目背景、表达偏好、关键决定与未完成事项，都能在下一次任务里自然接上。记忆是本地可读文件，你可以查看、编辑、备份或带走。',
      memoryItems: ['偏好：汇报先说结论，再给依据', '约束：这个项目统一使用 Bun', '进行中：官网重设计，等待移动端复核'],
      memoryQuote: '不用每次从头解释。Lume 知道你在做什么，也知道你希望怎么做。',
      localEyebrow: 'Local-first by design',
      localTitle: '你的工作不必先上传给别人',
      localDesc: '记忆、会话、技能、自动化和角色工作区都保存在 ~/.lume/。Markdown 与 YAML 是真源，普通工具就能打开。',
      localPoints: ['可读：没有私有数据格式锁定', '可控：敏感操作由你确认', '可迁移：复制目录即可备份与搬家'],
      toolsEyebrow: '真正能动手',
      toolsTitle: '一个工作台接入整套执行能力',
      toolsDesc: '文件、终端、浏览器、搜索、图片生成、Office 文档与 MCP 服务，统一在同一条任务上下文里协作。',
      toolLabels: ['文件系统', '终端命令', '网页与搜索', '图片生成', 'MCP 服务', '消息渠道', '定时自动化', '文档处理'],
      nightEyebrow: '离开电脑，工作也能继续',
      nightTitle: '安静运行也能按时交付',
      nightDesc: '把周期性任务交给自动化。Lume 在本地按计划运行，调用需要的角色与工具，再把结果推送到你常用的消息渠道。',
      nightItems: ['定时调研与日报', '跨角色并行执行', '结果主动推送'],
      nightStatus: '下一项任务 · 今天 22:00',
      nightArtAlt: 'Lume 在夜间本地工作台执行自动化任务',
      teamEyebrow: '不是一个万能人设',
      teamTitle: '是一支各有所长的 AI 团队',
      teamDesc: '每个角色都有清晰专长、独立工作区和做事方式。主线程负责理解你的目标，再把工作交给最适合的人。',
      teamAll: '13 位角色，随叫随到',
      teamNote: '角色不是装饰：它们拥有不同的系统提示、工具偏好与任务边界。',
      modelsEyebrow: '模型选择权在你',
      modelsTitle: '一个界面连接你信任的模型',
      modelsDesc: '兼容主流服务商与本地模型。按任务给不同角色分配模型，在成本、速度与效果之间自由选择。',
      sdkEyebrow: '也为开发者准备',
      sdkTitle: '把同一套 Agent 引擎放进你的产品',
      sdkDesc: 'Lume 的核心循环以独立 SDK 提供。无需依赖本地 CLI，就能在服务端、Docker、Serverless 或 CI 中运行。',
      sdkLink: '阅读 SDK 文档',
      faqEyebrow: '常见问题',
      faqTitle: '开始之前你可能还想知道',
      faqs: [
        { q: 'Lume 和普通 AI 聊天工具有什么不同？', a: '普通聊天工具更擅长一次性问答。Lume 面向持续工作：它能读写本地文件、调用工具、保存长期记忆，并把复杂任务交给多个专业角色推进。' },
        { q: '我的数据会保存在哪里？', a: '核心数据保存在你电脑的 ~/.lume/ 目录。记忆以 Markdown 为真源，配置使用可读格式，方便查看、备份和迁移。' },
        { q: '我可以使用自己的 API Key 或本地模型吗？', a: '可以。Lume 支持 OpenAI 兼容接口，可连接多家模型服务，也支持 Ollama、LM Studio 等本地模型方案。' },
        { q: 'Lume 是免费的吗？', a: 'Lume 本身基于 MIT 协议开源并可免费下载。你所连接的第三方模型服务，可能按各自规则产生费用。' },
      ],
      ctaEyebrow: '让 AI 真正进入工作现场',
      ctaTitle: '把下一件事交给 Lume',
      ctaDesc: '本地优先、免费开源。下载后，几分钟就能开始。',
      ctaSecondary: '先看看文档',
    }
  : {
      eyebrow: 'An AI work team that runs on your computer',
      heroTitleBefore: 'Turn one request into',
      heroTitleAccent: 'work that is actually done',
      heroDesc: 'Lume goes beyond answers. It understands your workspace, uses local tools, remembers long-term preferences, and sends a specialist agent team to deliver usable results.',
      heroPrompt: 'Research this market and turn the findings into a presentation-ready brief.',
      heroStatus: '3 agents are working in parallel',
      heroTask1: 'Milo · Verify sources',
      heroTask2: 'Tang · Synthesize the data',
      heroTask3: 'Lin · Shape the narrative',
      heroArtAlt: 'Lume collaborating with a specialist agent team in a studio',
      openSource: 'MIT open source',
      agentsCount: '13 specialists',
      localData: 'Local data',
      modelChoice: 'Your choice of model',
      stripLead: 'Not a smarter chat box.',
      stripTitle: 'A workbench that understands, delegates, and acts.',
      workflowEyebrow: 'One task, end to end',
      workflowTitle: 'You set the goal. Lume runs the process.',
      workflowDesc: 'From context to delivery, every step stays visible, pausable, and resumable.',
      workflows: [
        { step: '01', title: 'Understand the workspace', desc: 'Read the project, files, and relevant memories before deciding what the task really needs.', label: 'Context aligned' },
        { step: '02', title: 'Plan and delegate', desc: 'Break a complex goal into clear pieces and assign each one to the best-fit specialist.', label: 'Plan stays editable' },
        { step: '03', title: 'Use tools and act', desc: 'Search, edit files, run commands, and generate images instead of stopping at advice.', label: 'Progress stays visible' },
        { step: '04', title: 'Deliver usable work', desc: 'Return conclusions and artifacts in a thread you can keep moving forward.', label: 'Results saved locally' },
      ],
      casesEyebrow: 'From idea to artifact',
      casesTitle: 'Work, create, and research from one place',
      casesDesc: 'No elaborate prompt craft required. Describe the real need and Lume finds the next step.',
      cases: [
        { tag: 'Research', title: 'Turn scattered sources into a reliable point of view', desc: 'Search across sources, verify claims, map disagreements, and deliver a cited brief.', prompt: 'Compare five competitors and show me where the real opportunity is.', people: ['researcher', 'analyst'] },
        { tag: 'Build', title: 'Move real work forward inside a codebase', desc: 'Understand constraints, locate files, edit code, and verify the result with full context intact.', prompt: 'Fix this issue without changing the existing sign-in flow.', people: ['explorer', 'developer', 'code-reviewer'] },
        { tag: 'Create', title: 'Go from a blank page to something worth sharing', desc: 'Research, writing, translation, and visuals work together to shape a complete piece.', prompt: 'Turn these interviews into an opinionated long-form article.', people: ['writer', 'translator', 'artist'] },
        { tag: 'Automate', title: 'Let recurring work happen on schedule', desc: 'Create routines and automations, then receive the output in your messaging channel.', prompt: 'Every Monday, summarize progress and send me the top risks.', people: ['planner', 'analyst'] },
      ],
      memoryEyebrow: 'Context that stays',
      memoryTitle: 'It remembers more than chat history',
      memoryDesc: 'Project context, writing preferences, key decisions, and unfinished work carry into the next task. Memory is stored as readable local files you can inspect, edit, back up, or move.',
      memoryItems: ['Preference: lead with the conclusion', 'Constraint: this project uses Bun', 'In progress: website redesign, mobile review pending'],
      memoryQuote: 'No more starting from zero. Lume knows what you are doing and how you like to work.',
      localEyebrow: 'Local-first by design',
      localTitle: 'Your work does not need to be uploaded first',
      localDesc: 'Memories, threads, skills, automations, and agent workspaces live under ~/.lume/. Markdown and YAML remain the source of truth.',
      localPoints: ['Readable: no proprietary data lock-in', 'Controlled: you approve sensitive actions', 'Portable: copy one folder to back up or move'],
      toolsEyebrow: 'Built to act',
      toolsTitle: 'One workbench, a complete execution layer',
      toolsDesc: 'Files, terminals, browsers, search, image generation, Office artifacts, and MCP services all share the same task context.',
      toolLabels: ['File system', 'Terminal', 'Web & search', 'Image generation', 'MCP services', 'Messaging', 'Automation', 'Documents'],
      nightEyebrow: 'Work continues when you step away',
      nightTitle: 'Quietly running. Ready on time.',
      nightDesc: 'Hand recurring work to automations. Lume runs locally on schedule, brings in the right personas and tools, then sends the result to the channels you already use.',
      nightItems: ['Scheduled research and reports', 'Parallel specialist execution', 'Proactive result delivery'],
      nightStatus: 'Next task · Today at 10:00 PM',
      nightArtAlt: 'Lume running local automations at a nighttime workstation',
      teamEyebrow: 'Not one generic persona',
      teamTitle: 'A team with distinct specialties',
      teamDesc: 'Every persona has a clear specialty, workspace, and way of working. The main thread understands your goal and hands each part to the right person.',
      teamAll: '13 specialists, ready when needed',
      teamNote: 'Personas are functional: each has its own system prompt, tool preferences, and task boundaries.',
      modelsEyebrow: 'Keep your model choice',
      modelsTitle: 'One interface, the models you trust',
      modelsDesc: 'Connect leading providers and local models. Assign models by task and balance quality, speed, and cost on your terms.',
      sdkEyebrow: 'Made for builders too',
      sdkTitle: 'Put the same agent engine inside your product',
      sdkDesc: 'Lume ships its core loop as a standalone SDK. Run it in a server, Docker, serverless, or CI without a local CLI dependency.',
      sdkLink: 'Read the SDK docs',
      faqEyebrow: 'FAQ',
      faqTitle: 'A few things to know before you start',
      faqs: [
        { q: 'How is Lume different from a normal AI chat app?', a: 'Chat apps optimize for one-off answers. Lume is built for ongoing work: it can use local files and tools, keep durable memory, and delegate complex tasks across specialist personas.' },
        { q: 'Where is my data stored?', a: 'Core data lives in the ~/.lume/ folder on your computer. Memory uses Markdown as its source of truth, with readable configuration formats for easy backup and migration.' },
        { q: 'Can I use my own API key or a local model?', a: 'Yes. Lume supports OpenAI-compatible endpoints, a range of hosted providers, and local options such as Ollama and LM Studio.' },
        { q: 'Is Lume free?', a: 'Lume is free to download and open source under the MIT license. Third-party model providers may charge according to their own pricing.' },
      ],
      ctaEyebrow: 'Bring AI into the actual workspace',
      ctaTitle: 'Give the next task to Lume',
      ctaDesc: 'Local first, free, and open source. Get started in minutes.',
      ctaSecondary: 'Explore the docs',
    };

const providers = ['OpenAI', 'Anthropic', 'Gemini', 'DeepSeek', 'Qwen', 'Kimi', 'GLM', 'Doubao', 'OpenRouter', 'Ollama', 'LM Studio'];
const resolveMembers = (ids: readonly string[]) => members.filter((member) => ids.includes(member.id));
---

<Base title={t(lang, 'hero.title')} description={t(lang, 'hero.subtitle')}>
  <div class="landing-page">
  <section class="hero-grid relative isolate overflow-hidden border-b border-border/70">
    <div class="hero-orb hero-orb-one" aria-hidden="true"></div>
    <div class="hero-orb hero-orb-two" aria-hidden="true"></div>
    <div class="relative mx-auto grid min-h-[calc(100svh-3.5rem)] max-w-7xl items-center gap-12 px-4 py-16 sm:px-6 sm:py-20 lg:grid-cols-[0.95fr_1.05fr] lg:px-8 lg:py-24">
      <div class="relative z-10 max-w-2xl">
        <div class="section-eyebrow"><span class="status-dot"></span>{copy.eyebrow}</div>
        <h1 class="landing-hero-title mt-6 font-semibold text-fg">
          <span class={lang === 'zh' ? 'sm:whitespace-nowrap' : undefined}>{copy.heroTitleBefore}</span><br /><span class="text-gradient">{copy.heroTitleAccent}</span>
        </h1>
        <p class="mt-7 max-w-xl text-body-lg leading-loose text-fg-muted sm:text-title sm:leading-relaxed">{copy.heroDesc}</p>
        <div class="mt-9 flex flex-wrap items-center gap-3">
          <a href={downloadHref} class="button-primary group">
            {t(lang, 'hero.ctaDownload')}
            <svg viewBox="0 0 20 20" fill="none" class="h-4 w-4 transition-transform group-hover:translate-x-0.5" aria-hidden="true"><path d="M4 10h12m-5-5 5 5-5 5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"></path></svg>
          </a>
          <a href={REPO_URL} target="_blank" rel="noopener noreferrer" class="button-secondary">
            <svg viewBox="0 0 16 16" fill="currentColor" class="h-4 w-4" aria-hidden="true"><path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82A7.7 7.7 0 0 1 8 3.58c.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8Z"></path></svg>
            {t(lang, 'hero.ctaGithub')}
          </a>
        </div>
        <div class="mt-9 flex flex-wrap gap-x-6 gap-y-3 text-caption font-medium text-fg-muted">
          {[copy.openSource, copy.localData, copy.modelChoice].map((item) => (
            <span class="flex items-center gap-2"><svg viewBox="0 0 16 16" fill="none" class="h-4 w-4 text-accent" aria-hidden="true"><path d="m3.5 8.5 2.7 2.7 6.3-6.4" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"></path></svg>{item}</span>
          ))}
        </div>
      </div>

      <div class="relative lg:-mr-16 xl:-mr-24">
        <div class="hero-illustration relative isolate overflow-hidden rounded-[2rem] border border-border bg-[#e9eee6] shadow-2xl">
          <img
            src={withBase('/visuals/lume-hero-studio.webp')}
            alt={copy.heroArtAlt}
            width="2048"
            height="1152"
            loading="eager"
            fetchpriority="high"
            class="aspect-[5/4] w-full object-cover object-[68%_center] sm:aspect-[4/3] lg:aspect-[5/4]"
          />
          <div class="pointer-events-none absolute inset-0 bg-gradient-to-t from-[#0e1510]/28 via-transparent to-white/5" aria-hidden="true"></div>

          <div class="hero-product-window absolute bottom-4 left-4 w-[76%] overflow-hidden rounded-2xl border border-white/12 bg-[#11141c] p-1.5 shadow-2xl sm:bottom-6 sm:left-6 sm:w-[62%] sm:p-2">
            <div class="flex items-center justify-between px-2 py-1.5">
              <div class="flex gap-1"><span class="h-1.5 w-1.5 rounded-full bg-[#ff6b63]"></span><span class="h-1.5 w-1.5 rounded-full bg-[#f7c64d]"></span><span class="h-1.5 w-1.5 rounded-full bg-[#3ccf6e]"></span></div>
              <span class="text-[0.5rem] font-medium uppercase tracking-[0.16em] text-white/35">Lume workspace</span>
            </div>
            <img src={withBase('/screenshot.png')} alt={t(lang, 'hero.screenshotAlt')} width="1456" height="816" loading="eager" class="aspect-[16/9] w-full rounded-xl border border-white/8 object-cover" />
          </div>

          <div class="hero-task-card absolute right-3 top-3 hidden w-56 rounded-2xl border border-white/40 bg-white/82 p-4 text-[#192019] shadow-xl backdrop-blur-xl sm:block lg:-right-3 lg:top-8">
            <div class="flex items-center gap-2 text-caption font-semibold"><span class="status-dot"></span>{copy.heroStatus}</div>
            <div class="mt-3 space-y-1.5 text-micro text-[#5e685f]">
              {[copy.heroTask1, copy.heroTask2, copy.heroTask3].map((task, index) => (
                <div class="flex items-center gap-2 rounded-lg bg-[#f1f4ef] px-2.5 py-2"><span class={`h-1.5 w-1.5 rounded-full ${['bg-emerald-500', 'bg-violet-500', 'bg-amber-500'][index]}`}></span>{task}</div>
              ))}
            </div>
          </div>

          <div class="absolute bottom-3 right-3 max-w-[10rem] rounded-xl border border-white/35 bg-[#111712]/78 px-3 py-2 text-white shadow-lg backdrop-blur sm:bottom-6 sm:right-6 sm:max-w-[13rem]">
            <p class="text-[0.55rem] uppercase tracking-[0.16em] text-white/45">Prompt</p>
            <p class="mt-1 text-micro leading-relaxed text-white/82">“{copy.heroPrompt}”</p>
          </div>
        </div>
        <div class="mt-6 flex items-center justify-center gap-4">
          <div class="flex -space-x-2.5">{members.slice(0, 7).map((member) => <img src={withBase(`/agents/${member.avatar}`)} alt="" width="256" height="256" class="h-8 w-8 rounded-full border-2 border-bg object-cover" />)}</div>
          <span class="text-caption text-fg-muted">{copy.agentsCount}</span>
        </div>
      </div>
    </div>
  </section>

  <section class="border-b border-white/8 bg-inverse-bg text-inverse-fg">
    <div class="mx-auto flex max-w-7xl flex-col gap-2 px-4 py-7 sm:flex-row sm:items-baseline sm:justify-between sm:px-6 lg:px-8">
