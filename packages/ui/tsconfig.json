{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "dist",
    "rootDir": "src",
    "declaration": true,
    "jsx": "react-jsx",
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "types": []
  },
  "include": [
    "src/index.ts",
    "src/code-block/**/*",
    "src/hooks/**/*",
    "src/mermaid-block/**/*",
    "src/highlight/**/*"
  ],
  "exclude": ["src/**/*.test.ts", "src/**/*.test.tsx"]
}
