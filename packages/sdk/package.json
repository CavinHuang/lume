{
  "name": "@lume/agent-sdk",
  "version": "0.0.0",
  "description": "Open-source Agent SDK. Runs the full agent loop in-process — no local CLI required. Deploy anywhere: cloud, serverless, Docker, CI/CD.",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./plugins/*": "./src/plugins/*.ts"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "typecheck": "tsc --noEmit",
    "test": "bun run test:unit",
    "test:unit": "bun test src",
    "test:smoke": "bun test src/engine.test.ts src/tools/bash.test.ts"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "@lume/natives": "workspace:*",
    "@lume/shared": "workspace:*",
    "@microsoft/mxc-sdk": "0.8.0",
    "@modelcontextprotocol/sdk": "^1.12.1",
    "@mozilla/readability": "^0.6.0",
    "fast-xml-parser": "^5.2.3",
    "fflate": "^0.8.3",
    "jsdom": "^29.1.1",
    "mammoth": "^1.9.1",
    "mupdf": "^1.27.0",
    "sql.js": "^1.13.0",
    "turndown": "^7.2.4",
    "turndown-plugin-gfm": "^1.0.2",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/jsdom": "^28.0.3",
    "@types/node": "^22.0.0",
    "@types/turndown": "^5.0.6",
    "typescript": "^5.7.0"
  },
  "keywords": [
    "open-agent-sdk",
    "codeany",
    "agent",
    "sdk",
    "ai",
    "llm",
    "tools",
    "agentic",
    "coding-agent",
    "mcp"
  ],
  "license": "MIT"
}
